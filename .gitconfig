[user]
    name = Raphaël DURANDY
[init]
    defaultBranch = master
[alias]
    dw = diff --color-words
    dcw = diff --color-words --cached
[core]
    pager = less -FX
[column]
    ui = auto
[branch]
    sort = -committerdate
[diff]
    algorithm = histogram
    colorMoved = plain
[pull]
    rebase = true
[push]
    autoSetupRemote = true
    useForceIfIncludes = true
[rebase]
    autoSquash = true
    autoStash = true
[fetch]
    prune = true
[help]
    autocorrect = 1
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
